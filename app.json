{
  "expo": {
    "name": "FinanceU",
    "slug": "FinanceU",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financeu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "supportsTablet": true,

    "ios": {
      "bundleIdentifier": "com.Luke.FinanceU",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "FinanceU uses your location to show nearby banks, ATMs, and local financial-literacy classes on the map while you are using the app. For example, we center the map on your location and fetch places within 2 km to help you find resources near you."
      }
    },

    "android": {
      "package": "com.anonymous.FinanceU",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-maps"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc1e5085-7fe3-46a0-b409-8126b7100ef1"
      }
    }
  }
}
